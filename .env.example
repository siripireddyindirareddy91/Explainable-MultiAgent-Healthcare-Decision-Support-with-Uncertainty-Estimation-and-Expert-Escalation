# Local demo uses persistent SQLite. Vercel SQLite is temporary and may reset.
DEMO_MODE=true
# Required when DEMO_MODE=false; use a cryptographically random 32+ byte secret.
JWT_SECRET=
# Optional durable PostgreSQL database. Never commit credentials.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/clinixai?sslmode=require
CORS_ORIGINS=http://localhost:3000
